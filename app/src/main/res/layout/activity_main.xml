<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/inputNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/number_input_hint"
        android:inputType="number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/numberTypeFlow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="radioOdd,radioEven,radioPrime,radioPerfect,radioSquare,radioFibonacci"
        app:flow_horizontalAlign="center"
        app:flow_horizontalGap="16dp"
        app:flow_verticalGap="12dp"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputNumber"
        tools:ignore="MissingConstraints" />

    <RadioButton
        android:id="@+id/radioOdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/number_type_odd" />

    <RadioButton
        android:id="@+id/radioEven"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/number_type_even" />

    <RadioButton
        android:id="@+id/radioPrime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/number_type_prime" />

    <RadioButton
        android:id="@+id/radioPerfect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/number_type_perfect" />

    <RadioButton
        android:id="@+id/radioSquare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/number_type_square" />

    <RadioButton
        android:id="@+id/radioFibonacci"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/number_type_fibonacci" />

    <FrameLayout
        android:id="@+id/resultContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/numberTypeFlow">

        <ListView
            android:id="@+id/numberList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/no_numbers_message"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
